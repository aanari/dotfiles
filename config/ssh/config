# Machine-specific host definitions -- real hostnames, port forwards, which
# boxes get an agent -- live in ~/.ssh/config.local, which is not tracked:
# this repo is public. A missing Include is not an error, so this file is
# safe to deploy on a machine that has no config.local yet.
#
# Include it FIRST. ssh keeps the first value it obtains for each keyword,
# so per-host settings have to be read before the generic blocks below.
Include ~/.ssh/config.local

# --- autossh tunnels -------------------------------------------------
# Applies to the *-tunnel aliases defined in config.local, which exist
# purely for autossh to drive.
#
# autossh can only restart ssh when ssh EXITS, so these differ from the
# interactive hosts in two ways that matter:
#   1. multiplexing off. A multiplexed child attaches to the existing
#      master, exits 0 within milliseconds, and autossh reads that as a
#      failed start ("ssh exited prematurely with status 0") and quits.
#      This is the most common reason autossh looks broken.
#   2. fast liveness detection. 15s x 4 = ~60s to notice a dead link,
#      instead of the 10min the interactive defaults below allow. autossh
#      cannot reconnect until ssh gives up, so patience here is a cost.
Host *-tunnel
  ControlMaster no
  ControlPath none
  ExitOnForwardFailure yes
  SessionType none
  ServerAliveInterval 15
  ServerAliveCountMax 4

# Defaults for everything else.
#
# Cloudtop sshd runs ClientAliveInterval 30 / ClientAliveCountMax 20, so it
# hangs up after 600s of silence from us. Waiting longer than the server
# does just leaves dead sessions wedged, so cap at ~600s to match: past
# that the session is already gone on the far end.
Match all
  ServerAliveInterval 30
  ServerAliveCountMax 20
  TCPKeepAlive no
  ConnectTimeout 60
  ConnectionAttempts 5
  SendEnv LANG LC_*
  SendEnv TERM
